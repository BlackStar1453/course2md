{
  "manifest_version": 3,
  "name": "course2md",
  "version": "0.1.0",
  "description": "把当前页面正在播放的视频交给本机 course2md，转成带截图和时间戳的图文笔记。",
  "minimum_chrome_version": "105",
  "action": {
    "default_title": "用 course2md 转成笔记"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage"
  ]
}
